APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=dev

# Production guidance: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=info, LOG_CHANNEL=stderr_json
LOG_CHANNEL=stack
LOG_STACK=stderr_json,daily
LOG_LEVEL=debug
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=payroll
DB_USERNAME=root
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Prefer redis in staging/production for queue metrics and Horizon.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

IS_DEMO=false

OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-oss-120b:free
AI_MAX_TOKENS=4096
AI_MAX_TOOL_ROUNDS=5
AI_STT_FALLBACK=false

# Observability (see docs/observability.md)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=payroll-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER_RATIO=0.1
OTEL_EXPORT_TIMEOUT=0.5
OTEL_EXPORT_DISABLED=false
METRICS_TOKEN=
